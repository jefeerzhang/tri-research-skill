{
  // markdownlint rule configuration (shared by markdownlint-cli2 and editors).
  //
  // Semantics: flat rule map — "default": false turns every rule OFF, then the
  // rules below turn the ones we want back ON. This is the actual whitelist the
  // project enforces; the rules chosen are the most likely to surface document
  // corruption rather than style opinion.
  //
  // NOTE: cli2-only ignores (node_modules/.mimocode/examples) live in
  // .markdownlint-cli2.jsonc — keep rule changes here in sync conceptually with
  // the ignore list there.
  //
  // Add or remove rules at: https://github.com/DavidAnson/markdownlint
  "default": false,

  // Headings
  "MD018": true, // no-missing-space-atx (missing space after #)
  "MD019": true, // no-multiple-space-atx (#  vs ##)
  "MD022": true, // blanks-around-headings
  "MD023": true, // heading-start-left

  // Blocks
  "MD027": true, // no-multiple-space-blockquote
  "MD028": true, // no-blanks-blockquote
  "MD031": true, // blanks-around-fences
  "MD032": true, // blanks-around-lists
  "MD040": true, // fenced-code-language (every ``` must have a language)

  // Links / images / tables
  "MD042": true, // no-empty-links
  "MD045": true, // no-alt-text
  "MD052": true, // reference-links-images
  "MD056": true  // table-column-count
}
